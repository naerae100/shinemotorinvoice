{
  "version": 2,
  "regions": [
    "syd1"
  ],
  "builds": [
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/src/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/branding/(.*)",
      "dest": "/frontend/branding/$1",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "src": "/(favicon\\.svg|favicon-32\\.png|apple-touch-icon\\.png|robots\\.txt|manifest\\.webmanifest|pwa-[0-9a-z-]+\\.png)",
      "dest": "/frontend/$1",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "src": "/(sw\\.js|registerSW\\.js|workbox-[0-9a-f]+\\.js)",
      "dest": "/frontend/$1",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
