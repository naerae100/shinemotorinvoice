// Shine Metals — Docket & Invoice System
// Data model v1 — SQLite version for local development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Users / Auth
// ─────────────────────────────────────────────
// Role values: "ADMIN" | "STAFF"

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Bumped on password change or "sign out everywhere". A token carries the
  // version it was minted with, so raising this instantly invalidates every
  // token already issued — a JWT is otherwise valid until it expires, and a
  // tablet lost on the yard cannot be locked out any other way.
  tokenVersion Int @default(0)

  auditEvents AuditEvent[]

  docketsCreated  Docket[]        @relation("DocketCreatedBy")
  docketsEdited   Docket[]        @relation("DocketEditedBy")
  docketsVoided   Docket[]        @relation("DocketVoidedBy")
  docketsPaid     Docket[]        @relation("DocketPaidBy")
  invoicesCreated ExportInvoice[] @relation("InvoiceCreatedBy")
  invoicesEdited  ExportInvoice[] @relation("InvoiceEditedBy")
  invoicesVoided  ExportInvoice[] @relation("InvoiceVoidedBy")

  localSuppliersCreated LocalSupplier[] @relation("LocalSupplierCreatedBy")
  collectionsCreated    Collection[]    @relation("CollectionCreatedBy")
  collectionsEdited     Collection[]    @relation("CollectionEditedBy")
  collectionsVoided     Collection[]    @relation("CollectionVoidedBy")
}

// ─────────────────────────────────────────────
// Audit trail
// ─────────────────────────────────────────────

/// Append-only. Nothing in the application updates or deletes a row here: the
/// point of the table is that it records what happened even when the record it
/// describes has since been changed again. `createdBy`/`editedBy` on a document
/// only ever show the *latest* actor and never say what changed.
model AuditEvent {
  id String   @id @default(cuid())
  at DateTime @default(now())

  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id])
  // Denormalised so the trail still names someone after a user row is edited.
  actorEmail String?

  // Action values: "CREATE" | "UPDATE" | "VOID" | "RESTORE" | "ISSUE" | "PAY" |
  // "UNPAY" | "LOGIN" | "LOGIN_FAILED"
  action   String
  entity   String // "Docket" | "ExportInvoice" | "User" | ...
  entityId String
  label    String? // human handle, e.g. "Docket #123"

  // The changed fields only, before and after — not the whole row, which would
  // make the table larger than the data it describes.
  before Json?
  after  Json?

  ip String?

  @@index([entity, entityId])
  @@index([at])
  @@index([actorId])
}

// ─────────────────────────────────────────────
// Materials master list (the 33-item price list)
// ─────────────────────────────────────────────
// MaterialUnit values: "KG" | "TONNE" | "UNIT"

model Material {
  id          String @id @default(cuid())
  code        Int?   @unique
  description String

  // "PURCHASE" | "EXPORT"
  //
  // The yard buys and sells the same metal under different names. A supplier is
  // paid for "Copper Bright Wire" off the price list; the same metal is sold to
  // an overseas mill as "Mill Berry", the trade grade the buyer's contract is
  // written in. Keeping both in one table under a kind means a docket offers the
  // buying names and an export invoice the selling ones, without either list
  // having to carry the other's vocabulary.
  //
  // Defaults to PURCHASE so the existing 33-item price list is unaffected.
  kind String @default("PURCHASE")

  category     String?
  unit         String   @default("KG")
  currentPrice Decimal
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  docketLines     DocketLineItem[]
  invoiceLines    InvoiceLineItem[]
  collectionLines CollectionLine[]

  @@index([kind])
}

// ─────────────────────────────────────────────
// Suppliers (sellers bringing scrap in)
// ─────────────────────────────────────────────
// SaleType values: "PRIVATE" | "BUSINESS"

model Supplier {
  id   String @id @default(cuid())
  name String

  // A postal address in the parts a delivery or a statement actually needs.
  // `address` is the street line; state and country were missing entirely, so
  // an address could not be written out in full on a printed document.
  address   String?
  suburb    String?
  state     String?
  postcode  String?
  country   String?
  phone     String?
  email     String?
  saleType  String  @default("PRIVATE")
  abn       String?
  licenceNo String?

  /// Where this supplier is paid.
  ///
  /// The yard does not always pay at the weighbridge — a load is taken, the
  /// docket is written, and the transfer happens later that day or the next.
  /// Holding the account on the supplier rather than re-asking every time means
  /// an unpaid docket can be settled from the record, and the second load from
  /// the same seller already has the details on it.
  ///
  /// Payment is EFT, never cash: NSW scrap metal law requires it, which is why
  /// this belongs on the record rather than being a convenience.
  bankAccountName String?
  bankBsb         String?
  bankAccountNo   String?
  /// PayID is an alternative to BSB/account — an email or mobile. Either may be
  /// filled in; plenty of private sellers have only one of the two.
  payId           String?

  createdAt DateTime @default(now())

  dockets        Docket[]
  localSuppliers LocalSupplier[]

  @@index([name])
}

// ─────────────────────────────────────────────
// Purchase Dockets (replaces the paper pad)
// ─────────────────────────────────────────────
// DocketType values: "TAX_INVOICE" | "PURCHASE_DOCKET"
// PaygStatement values: "PRIVATE_HOBBY" | "TAX_EXEMPT" | "SCRAP_CODE_NO_ABN" | "NOT_APPLICABLE"

model Docket {
  id           String   @id @default(cuid())
  docketNumber Int      @unique // managed in application code (max + 1)
  type         String   @default("PURCHASE_DOCKET")
  // TaxMode values: "EXCLUSIVE" | "INCLUSIVE" | "NO_TAX"
  // Inclusive is the default because the yard quotes suppliers a price per kilo
  // with GST already in it — that is the number said out loud at the weighbridge.
  taxMode      String   @default("INCLUSIVE")
  date         DateTime @default(now())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  vehicleReg   String?
  vehicleModel String?
  vehicleVin   String?

  paygStatement String?

  // PaymentStatus values: "PAID" | "UNPAID".
  //
  // Defaults to PAID because settling on the spot is the ordinary case, and
  // because every docket already in the system was settled at the time — a
  // default of UNPAID would make the whole history read as money owed. UNPAID
  // is the deliberate exception: the manager with bank access is not on site,
  // so the goods are bought, the supplier's account details are taken, and the
  // transfer happens later.
  paymentStatus    String    @default("PAID")
  paidAt           DateTime?
  // "TRANSFER" | "PAYID" | "CHEQUE". Cash is deliberately not an option: NSW
  // scrap metal law requires payment by EFT, so offering it would be inviting
  // the system to record an unlawful transaction.
  paymentMethod    String?
  // Bank reference, receipt number, or whatever makes the payment findable
  // again when the supplier rings up asking about it.
  paymentReference String?
  paidById         String?
  paidBy           User?     @relation("DocketPaidBy", fields: [paidById], references: [id])

  // Status values: "ACTIVE" | "VOID". Voided records keep their docket number and
  // stay in history for the audit trail, but are excluded from every total.
  status     String    @default("ACTIVE")
  voidReason String?
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("DocketVoidedBy", fields: [voidedById], references: [id])

  subtotal Decimal @default(0)

  // Xero integration
  xeroInvoiceId String?

  // DiscountType values: "NONE" | "PERCENT" | "FIXED"
  discountType   String  @default("NONE")
  discountValue  Decimal @default(0) // the percentage, or the fixed dollar amount
  discountAmount Decimal @default(0) // resolved dollar value, snapshotted

  gst   Decimal @default(0)
  total Decimal @default(0)

  // Set when the docket is handed to the supplier. After that the record is
  // evidence of a completed transaction, not a draft, and the API refuses edits.
  issuedAt DateTime?

  supplierSignedAt  DateTime?
  buyerSignedAt     DateTime?
  signatureImageUrl String?

  notes String?

  createdById String
  createdBy   User    @relation("DocketCreatedBy", fields: [createdById], references: [id])
  editedById  String?
  editedBy    User?   @relation("DocketEditedBy", fields: [editedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems DocketLineItem[]

  @@index([date])
  @@index([supplierId])
  @@index([status])
  // The "to pay" run filters on this every time it is opened, and it is the
  // one query that must stay quick while the unpaid list is short and the
  // paid history behind it grows without limit.
  @@index([paymentStatus])
}

model DocketLineItem {
  id       String @id @default(cuid())
  docketId String
  docket   Docket @relation(fields: [docketId], references: [id], onDelete: Cascade)

  // Optional, as on an invoice line: a one-off grade can be typed straight onto
  // the docket without first being added to the price list. Either materialId or
  // description must be present — the API enforces that.
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])
  description String?

  netWeight Decimal
  price     Decimal
  value     Decimal

  @@index([docketId])
}

// ─────────────────────────────────────────────
// Export Invoices (container shipments)
// ─────────────────────────────────────────────

model Consignee {
  id   String @id @default(cuid())
  name String

  /// The address as one blob. Every one of the 91 buyers imported from the
  /// export archive arrived this way — street, city and country run together in
  /// a single cell — and it is kept as the fallback for those, and as what
  /// still prints when the parts below have not been filled in.
  address String?

  /// The same address in its parts, which is what a commercial document and a
  /// customs form actually ask for. Filled in going forward; the blob above is
  /// what an un-revisited imported buyer still shows.
  street   String?
  suburb   String?
  state    String?
  postcode String?

  email   String?
  phone   String?
  country String?

  // A buyer often trades under several billing entities — PT Daiki bills through
  // Indonesia, Thailand and Malaysia, HANWA through four. Each is its own
  // Consignee; groupName is what they are collectively called on the yard floor,
  // so the picker can offer them together.
  groupName String?

  abn     String?
  website String?

  // The historic archive carries more than one contact for some buyers. `email`
  // and `phone` above stay the ones we actually send to; these are the rest.
  extraEmails String[] @default([])
  extraPhones String[] @default([])

  // Prefilled on a new invoice, because a given buyer almost always trades on the
  // same terms in the same currency. Both remain editable per invoice.
  defaultCurrency     String? // "AUD" | "USD"
  defaultShippingTerm String?

  notes String?

  // Which folder of the export archive this record was imported from, kept so a
  // reconciliation against the original invoices is possible later.
  archiveFolder String?

  invoices ExportInvoice[]

  @@index([groupName])
}

// Payment must be made to a different Westpac account depending on the currency
// of the invoice — AUD collects at Ingleburn, USD at Parramatta Square. Printing
// the wrong one sends an international wire into the wrong account, so the
// account is keyed by currency rather than being a single company-wide block.
model BankAccount {
  id       String @id @default(cuid())
  currency String @unique // "AUD" | "USD"

  bankName    String?
  swift       String?
  accountNo   String?
  bsb         String?
  bankAddress String?
  beneficiary String?

  updatedAt DateTime @updatedAt
}

model ExportInvoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  date          DateTime @default(now())

  consigneeId String
  consignee   Consignee @relation(fields: [consigneeId], references: [id])

  // "AUD" | "USD". Every amount on this invoice and its lines is denominated in
  // it; a USD invoice is recorded in USD only, with no AUD equivalent.
  currency String @default("AUD")

  // "PACKING_SLIP" | "INVOICED"
  //
  // A shipment is one record with two stages, not two records. It starts as a
  // packing slip — the goods weighed onto it, gross/tare/net, no prices — and
  // becomes an invoice when those net weights are priced. Holding both stages
  // on one row is what guarantees the weight customs clears and the weight the
  // buyer is billed for are the same number; two tables could drift apart, and
  // the packing list already prints the invoice's own number.
  //
  // Defaults to INVOICED so every row written before this field existed — the
  // whole imported archive included — stays an invoice.
  stage String @default("INVOICED")

  shippingTerm    String?
  fasPort         String?
  poNumber        String?
  // Some buyers reference a contract rather than a PO, and for them the contract
  // number is what gets printed — occasionally as the invoice number itself.
  contractNo      String?
  modeOfTransport String?

  // Status values: "ACTIVE" | "VOID"
  status     String    @default("ACTIVE")
  voidReason String?
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])

  subtotal Decimal @default(0)

  // Xero integration
  xeroInvoiceId String?

  // DiscountType values: "NONE" | "PERCENT" | "FIXED"
  discountType   String  @default("NONE")
  discountValue  Decimal @default(0)
  discountAmount Decimal @default(0)

  // Exports are GST-free, but the same document is used for local sales, where
  // 10% applies. The operator chooses per invoice rather than it being implied.
  applyGst Boolean @default(false)
  gst      Decimal @default(0)

  total Decimal @default(0)

  // Set when the invoice is sent to the buyer. They may pay against it, so from
  // that moment the figures are frozen; a correction is a new document.
  issuedAt DateTime?

  bankSnapshot String?

  createdById String
  createdBy   User    @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  editedById  String?
  editedBy    User?   @relation("InvoiceEditedBy", fields: [editedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems  InvoiceLineItem[]
  containers InvoiceContainer[]

  @@index([date])
  @@index([consigneeId])
  @@index([status])
  @@index([stage])
}

// One shipment can fill several containers, and the goods in each are listed
// separately. The old single containerNo/seal/containerType trio could only
// describe one, which is why operators were appending the container number to
// the description text ("HEAVY MELTING SCRAP - CAIU6523084").
model InvoiceContainer {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   ExportInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  containerNo   String?
  seal          String?
  containerType String? // "1 x 20FT", "1 x 40FT"

  position Int @default(0)

  lineItems InvoiceLineItem[]

  @@index([invoiceId])
}

model InvoiceLineItem {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   ExportInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Optional: a one-off product can be typed straight onto the invoice without
  // first being added to the material list. Either materialId or description
  // must be present — the API enforces that, since a line with neither would
  // print as a blank row.
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  // Which container these goods travelled in. Null on a single-container
  // shipment, where naming the container per line would just be noise.
  containerId String?
  container   InvoiceContainer? @relation(fields: [containerId], references: [id], onDelete: SetNull)

  description  String?
  // As printed in the packing list's parentheses: "13 bags", "16 IBC".
  packageCount String?

  // The packing list weighs the load; the invoice bills the net. Gross and tare
  // are nullable because an invoice may be raised before the truck is weighed,
  // but net is always what gets multiplied by the price.
  grossWeightMt Decimal?
  tareWeightMt  Decimal?
  netWeightMt   Decimal

  pricePerMt Decimal
  total      Decimal

  position Int @default(0)

  @@index([invoiceId])
  @@index([containerId])
}

// ─────────────────────────────────────────────
// Company settings (single row) — logo, stamp, bank details
// ─────────────────────────────────────────────

model CompanySettings {
  id          String  @id @default("singleton")
  companyName String  @default("Shine Motor Corporation Pty Ltd")
  abn         String?
  acn         String?
  address     String?
  phone       String?
  mobile      String?
  fax         String?
  email       String?
  website     String?
  logoUrl     String?
  stampUrl    String?

  bankName      String?
  bankSwift     String?
  bankAccountNo String?
  bankBsb       String?
  bankAddress   String?
  beneficiary   String?

  // Xero integration
  xeroTenantId       String?
  xeroAccessToken    String?
  xeroRefreshToken   String?
  xeroTokenExpiresAt DateTime?
}

// ─────────────────────────────────────────────────────────────────────────
//  Field collections
//
//  A contractor drives out, weighs scrap at the seller's place and writes
//  down what was picked up. No price is agreed and no money moves — pricing
//  happens back at the yard, if it happens at all. Today this is a paper
//  notebook that somebody re-keys by hand.
//
//  Deliberately NOT modelled as a Docket. Every report, total and BAS figure
//  in reports.js selects ACTIVE dockets, so a priceless collection folded
//  into that table would land in "Scrap bought", in the docket counts and in
//  the GST figures as a zero-value row — wrong in a way nobody would notice
//  until the quarter was reconciled. A Docket also requires a Supplier, which
//  carries ABN and bank details a contractor must never see, and carries
//  payment status, GST and discount, none of which exist here.
// ─────────────────────────────────────────────────────────────────────────

/// A seller the contractor deals with in the field.
///
/// Separate from Supplier even though they are often the same people. Two
/// reasons: the contractor's search should offer the handful of names they
/// actually visit rather than the yard's whole book, and the Supplier table
/// holds ABNs and bank accounts that this role has no business reading.
model LocalSupplier {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  address  String?
  suburb   String?
  state    String?
  postcode String?
  notes    String?

  /// Set by an admin when a local seller turns out to be, or becomes, a
  /// registered supplier. Nothing reads it yet — it exists so that matching
  /// the two up later is an update rather than a migration against live data.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("LocalSupplierCreatedBy", fields: [createdById], references: [id])

  collections Collection[]

  @@index([name])
}

/// One pickup: who it came from, and what was weighed.
model Collection {
  id               String   @id @default(cuid())
  /// Its own sequence, unrelated to docketNumber — these are not dockets and
  /// sharing a run of numbers would imply they are.
  collectionNumber Int      @unique
  date             DateTime @default(now())

  localSupplierId String
  localSupplier   LocalSupplier @relation(fields: [localSupplierId], references: [id])

  notes String?

  /// "ACTIVE" | "VOID", the same convention as a docket: voided records keep
  /// their number and stay in history rather than disappearing.
  status     String    @default("ACTIVE")
  voidReason String?
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("CollectionVoidedBy", fields: [voidedById], references: [id])

  /// Set when an admin prices this up into a real purchase docket. Unused for
  /// now; here so that step does not need a migration later.
  docketId String? @unique

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("CollectionCreatedBy", fields: [createdById], references: [id])

  /// The contractor may correct their own entry, so the record has to say who
  /// touched it last. The full before/after is in AuditEvent; this is what the
  /// admin sees on the record itself without opening the trail.
  updatedAt  DateTime  @updatedAt
  editedAt   DateTime?
  editedById String?
  editedBy   User?     @relation("CollectionEditedBy", fields: [editedById], references: [id])

  lines CollectionLine[]

  @@index([localSupplierId])
  @@index([date])
  @@index([status])
}

/// One grade on a pickup. Weighed in its own bin, so each line carries its own
/// tare rather than one tare for the vehicle.
model CollectionLine {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  /// As on a docket line: a grade can be typed straight in without first being
  /// added to the price list. The API requires one of the two.
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])
  description String?

  /// What our scales said. Kilograms. net is stored rather than derived so the
  /// number the contractor saw in the field is the number kept, even if the
  /// arithmetic ever changes.
  grossWeight Decimal
  tareWeight  Decimal @default(0)
  netWeight   Decimal

  /// What the supplier's scales said, weighed independently — their own
  /// container, their own tare. Nullable throughout: a seller who does not
  /// weigh, or has not weighed yet, leaves these empty and the line is still
  /// a complete record of what we took.
  ///
  /// The difference is deliberately NOT stored. It is ours minus theirs and
  /// nothing else, so deriving it means there is one place it can be wrong
  /// rather than two that can disagree.
  supplierGrossWeight Decimal?
  supplierTareWeight  Decimal?
  supplierNetWeight   Decimal?

  @@index([collectionId])
}
