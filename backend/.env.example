# Shine Metals — backend environment
#
# Copy to .env for local development. Production values live in Vercel's
# project settings, not in a file.
#
# Every variable here is read by the code. If something is missing from this
# list it is not configurable; if something is listed and you leave it out,
# the comment says what happens.
#
#   .env          local development — points at the LOCAL database
#   .env.sydney   production credentials, used only by the :prod scripts
#
# Keeping those apart is deliberate. `npm run dev` and `npm run seed` read
# .env, so if .env held production then the two commands you reach for
# without thinking would be talking to live data.


# ── Database ─────────────────────────────────────────────────────────────
# DATABASE_URL is the pooled connection the app uses. DIRECT_URL bypasses
# the pooler and is what Prisma needs for migrations.
#
# The app refuses to start if either points at ap-northeast-1 — that is the
# decommissioned Tokyo instance, which still answers, so every query would
# quietly succeed against dead data.
DATABASE_URL=postgresql://postgres@localhost:5433/shine_dev
DIRECT_URL=postgresql://postgres@localhost:5433/shine_dev


# ── Sessions ─────────────────────────────────────────────────────────────
# Required. The app will not start without it, and refuses anything under 32
# characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# It also signs photo URLs and the Drive setup flow, so changing it signs
# everyone out and invalidates any photo link already on screen.
JWT_SECRET=

# How long a session survives unused. Sessions slide while in use, so this is
# an idle window rather than a hard limit. Default 14d.
JWT_EXPIRES_IN=14d


# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Where the browser app is served from, for CORS. Optional in production:
# Vercel supplies the deployment's own domain, so leaving this unset is fine
# there. Set it for a custom domain.
FRONTEND_URL=http://localhost:5173

# Every business date — dashboard days, BAS quarters, the financial year —
# is worked out in this zone rather than the server's. Default
# Australia/Sydney.
BUSINESS_TZ=Australia/Sydney


# ── Collection photographs ───────────────────────────────────────────────
# Stored in Google Drive. Full setup, including why this is OAuth rather
# than a service account, is in DRIVE.md.
#
# Leave these blank and the app still works: the upload buttons are hidden
# and the form says photo storage is not connected. Weights save as normal.
#
# This file is COMMITTED. Real values belong in .env, which is not. Anything
# typed here goes to the repository the moment somebody commits.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Minted once by visiting /api/drive/auth as an admin and approving. Treat it
# like a password — it can read and write every file this app creates.
GOOGLE_REFRESH_TOKEN=

# Optional. A folder id from its Drive URL, to keep collections under one
# folder instead of the Drive root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Optional. Only needed for a custom domain — otherwise the callback is
# worked out from the deployment. /api/drive/status prints the exact value
# to register with Google.
GOOGLE_REDIRECT_URI=

# Development only: write photos to backend/.photos/ instead of Drive, so
# the upload path can be exercised before Google is connected. Any value
# other than `local` is ignored, and it is not a production fallback —
# Vercel's filesystem is ephemeral.
PHOTO_STORAGE=local


# ── ABN lookup ───────────────────────────────────────────────────────────
# Optional, free from the ABR. Without it the ABN field still validates the
# ATO check digit; it just cannot show the registered entity name.
#   https://abr.business.gov.au/Tools/WebServices
ABR_GUID=


# ── Xero ─────────────────────────────────────────────────────────────────
# Optional. The integration is dormant without these.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=


# ── Seeding ──────────────────────────────────────────────────────────────
# Read once, by prisma/seed.js, when creating the first admin and the
# company settings row. Not read by the running app.

SEED_ADMIN_PASSWORD=

# The bank block printed on export invoices. Seeded into the settings table
# and editable in Settings afterwards, so these only matter on a fresh
# database.
BANK_NAME=
BANK_SWIFT=
BANK_BENEFICIARY=
BANK_AUD_ACCOUNT=
BANK_AUD_BSB=
BANK_AUD_ADDRESS=
BANK_USD_ACCOUNT=
BANK_USD_BSB=
BANK_USD_ADDRESS=
