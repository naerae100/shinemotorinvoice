# ─── Database ────────────────────────────────────────────────────────────────
# Both are required — schema.prisma references each of them.
#
# DATABASE_URL: the pooled (transaction-mode) connection the app runs on.
#   Keep ?pgbouncer=true — Prisma disables prepared statements without it.
#   connection_limit caps how many pooled connections one function instance
#   opens; the dashboard issues ~11 queries at once, so give it room.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=10"

# DIRECT_URL: the session-mode connection, used only for migrations.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Host the database in the same region as the Vercel functions (see the
# "regions" key in vercel.json). A cross-region hop costs ~180ms on EVERY
# query, which dominates response time regardless of how little data there is.

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters in production or the server refuses to start.
JWT_SECRET="replace-with-a-long-random-string"

# ─── App ─────────────────────────────────────────────────────────────────────
# Only used for CORS in local development. On Vercel the frontend and API are
# served from the same origin, so this is not needed there.
FRONTEND_URL="http://localhost:5173"

PORT=4000
NODE_ENV=development

# Only used by the seed script to set the first admin password
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ─── Tests (optional) ────────────────────────────────────────────────────────
# A scratch PostgreSQL database for the API integration tests. It is DROPPED AND
# RECREATED on every run, so never point this at real data. Without it, the 42
# API tests skip (loudly) and only the money unit tests run.
#   docker run --rm -d -p 5433:5432 -e POSTGRES_PASSWORD=test --name shine-test postgres:16
# TEST_DATABASE_URL="postgresql://postgres:test@localhost:5433/postgres"
