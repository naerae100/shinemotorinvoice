# Database — Railway/Vercel Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/shinemetals"

# JWT signing secret — generate a long random string, never commit the real one
JWT_SECRET="replace-with-a-long-random-string"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

PORT=4000
NODE_ENV=development

# Only used by the seed script to set the first admin password
SEED_ADMIN_PASSWORD="ChangeMe123!"
