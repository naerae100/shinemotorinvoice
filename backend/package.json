{
  "name": "shine-metals-backend",
  "version": "1.0.0",
  "description": "Shine Metals docket & invoice system \u2014 backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "db:start": "/opt/homebrew/opt/postgresql@16/bin/pg_ctl -D $HOME/.local/share/shine-metals/pgdata -o \"-p 5433 -c listen_addresses=localhost -c unix_socket_directories=''\" -l $HOME/.local/share/shine-metals/pg.log start",
    "db:stop": "/opt/homebrew/opt/postgresql@16/bin/pg_ctl -D $HOME/.local/share/shine-metals/pgdata stop -m fast",
    "dev:local": "DATABASE_URL=postgresql://postgres@localhost:5433/shine_dev DIRECT_URL=postgresql://postgres@localhost:5433/shine_dev FRONTEND_URL=http://localhost:5174 PHOTO_STORAGE=local node --watch src/index.js",
    "seed:local": "DATABASE_URL=postgresql://postgres@localhost:5433/shine_dev DIRECT_URL=postgresql://postgres@localhost:5433/shine_dev SEED_ADMIN_PASSWORD=ShineDev12345 node prisma/seed.js",
    "migrate:local": "DATABASE_URL=postgresql://postgres@localhost:5433/shine_dev DIRECT_URL=postgresql://postgres@localhost:5433/shine_dev npx prisma migrate deploy",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "seed:export-grades": "node prisma/seed-export-grades.js",
    "rotate:db-password": "bash scripts/rotate-db-password.sh",
    "migrate:prod": "bash scripts/migrate-prod.sh",
    "clear:transactions:local": "DATABASE_URL=postgresql://postgres@localhost:5433/shine_dev node prisma/clear-transactions.js",
    "clear:transactions:prod": "set -a; . ./.env.sydney; set +a; DATABASE_URL=\"$SYDNEY_DIRECT_URL\" node prisma/clear-transactions.js",
    "backup:prod": "bash scripts/backup-prod.sh",
    "seed:export-grades:local": "DATABASE_URL=postgresql://postgres@localhost:5433/shine_dev DIRECT_URL=postgresql://postgres@localhost:5433/shine_dev node prisma/seed-export-grades.js",
    "demo": "node prisma/demo.js",
    "demo:clear": "node prisma/demo.js --clear",
    "test": "node --test \"tests/**/*.test.js\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.0",
    "xero-node": "^19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.20.0"
  }
}
